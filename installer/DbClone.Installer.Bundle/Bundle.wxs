<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Bundle Name="DbClone $(var.ProductVersion)"
          ProviderKey="0A456B98-678F-49F7-887D-484F24F29398"
          Manufacturer="DbClone Contributors"
          Version="$(var.ProductVersion)"
          UpgradeCode="B4E8C3F2-7A5D-4F9B-C6E1-3D6C9B4F8A01"
          IconSourceFile="..\DbClone.Installer.UI\Assets\app.ico"
          AboutUrl="https://github.com/AlexNek/DbClone"
          HelpUrl="https://github.com/AlexNek/DbClone/issues"
          UpdateUrl="https://github.com/AlexNek/DbClone/releases">

    <!-- Custom WPF wizard bootstrapper application (DbClone.Installer.UI).
         Published as a self-contained single-file exe by build-installer-wix.ps1
         before this project builds. Handles full UI, silent /passive /quiet
         runs (app autoupdate) and ARP uninstall/repair actions. -->
    <BootstrapperApplication
      SourceFile="..\DbClone.Installer.UI\bin\publish\DbClone.Installer.UI.exe" />

    <!-- Detect existing Inno Setup installation by registry. Writes directly into
         InstallFolder so the Options page editbox and the MSI use the previous path.
         The search only sets the variable when the value is found; on clean machines
         the formatted default below applies instead. -->
    <util:RegistrySearch
      Id="InnoInstallPath"
      Root="HKLM"
      Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\{A3F7C2E1-9B4D-4E8A-B6F1-2D5C8A3E7F90}_is1"
      Value="InstallLocation"
      Variable="InstallFolder" />

    <!-- Default install location; the Options page editbox is bound to this variable.
         Type="formatted" makes Burn resolve [ProgramFiles64Folder] when the value is
         read (a plain string Variable would keep the brackets literally). -->
    <Variable Name="InstallFolder"
              Type="formatted"
              Value="[ProgramFiles64Folder]DbClone" />

    <Variable Name="InstallDesktopShortcut"
              Type="numeric"
              Value="0"
              Persisted="yes" />

    <!-- WebView2 Evergreen runtime detection (D11). The client's "pv" value under
         EdgeUpdate is the version the runtime reports; its mere presence means the
         runtime is installed, which is all the app needs. Two searches because the
         runtime can be per-machine or per-user: the first key is the documented
         64-bit location, the second is the un-elevated install. Each writes 1 into a
         numeric variable that defaults to 0, so the condition below needs no string
         juggling when a value is absent. -->
    <Variable Name="WebView2MachineRuntime" Type="numeric" Value="0" />
    <Variable Name="WebView2UserRuntime" Type="numeric" Value="0" />

    <util:RegistrySearch
      Id="WebView2MachineRuntimeSearch"
      Root="HKLM"
      Key="SOFTWARE\WOW6432Node\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
      Value="pv"
      Result="exists"
      Variable="WebView2MachineRuntime" />

    <util:RegistrySearch
      Id="WebView2UserRuntimeSearch"
      Root="HKCU"
      Key="Software\Microsoft\EdgeUpdate\Clients\{F3017226-FE2A-4295-8BDF-00C3A9A7E4C5}"
      Value="pv"
      Result="exists"
      Variable="WebView2UserRuntime" />

    <!-- Install chain -->
    <Chain DisableSystemRestore="yes">

      <!-- WebView2 Evergreen runtime, Microsoft's own bootstrapper (fetched by
           build-installer-wix.ps1 into artifacts\prerequisites; the bundle build
           never reaches the network). Permanent because uninstalling DbClone must
           not remove a runtime other software shares, and not vital because the
           app falls back to the browser without it (D10) - a runtime that cannot
           be installed must not fail the product's install. -->
      <ExePackage Id="WebView2Runtime"
                  SourceFile="!(bindpath.Prerequisites)\MicrosoftEdgeWebView2Setup.exe"
                  DetectCondition="WebView2MachineRuntime OR WebView2UserRuntime"
                  InstallArguments="/silent /install"
                  Protocol="none"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="no" />

      <!-- DbClone MSI -->
      <MsiPackage Id="DbCloneMsi"
                  SourceFile="!(bindpath.DbClone.Installer.Msi)\DbClone.msi">
        <!-- INSTALLFOLDER is only passed for fresh installs (incl. the Inno
             migration case, where InstallFolder holds the old path). On
             update/repair the MSI major upgrade keeps the existing location
             on its own - overriding it here would relocate the product. -->
        <MsiProperty Name="INSTALLFOLDER" Value="[InstallFolder]"
                     Condition="NOT WixBundleInstalled" />
        <MsiProperty Name="INSTALLDESKTOPSHORTCUT" Value="[InstallDesktopShortcut]" />
      </MsiPackage>

    </Chain>

  </Bundle>

</Wix>
