<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>DbClone.Installer.UI</AssemblyName>
    <RootNamespace>DbClone.Installer</RootNamespace>
    <!-- Disable App.xaml auto-startup; Burn controls entry via Program.cs -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\banner.png" />
    <Resource Include="Assets\banner.bmp" />
    <Resource Include="Assets\dialog.bmp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="5.0.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="LICENSE.rtf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
