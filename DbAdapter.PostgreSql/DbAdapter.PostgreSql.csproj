  </PropertyGroup>

  <ItemGroup>
    <Content Include="platforms\**\*.platform" Link="platforms\postgresql\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
