<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CanonicalModel\CanonicalModel.csproj" />
    <ProjectReference Include="..\DbAdapter.Definitions\DbAdapter.Definitions.csproj" />
    <ProjectReference Include="..\src\DbClone.Application\DbClone.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DbAdapter.PostgreSql.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.9" />
