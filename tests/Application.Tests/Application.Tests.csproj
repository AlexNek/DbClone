<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="6.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DbClone.Application\DbClone.Application.csproj" />
    <ProjectReference Include="..\..\DbAdapter.PostgreSql\DbAdapter.PostgreSql.csproj" />
    <!--
      The P9 proof plugin (refactors/09). ReferenceOutputAssembly=false keeps the stub assembly out
      of this test's compile surface and out of its default load context — the catalog must bind it
      from a folder in its own PluginAssemblyLoadContext to prove single type identity across
      contexts. The reference exists only to guarantee the stub is built before this project's
      CopyStubPluginForCatalogTests target stages it into $(OutDir)stubplugin\ for the catalog test.
    -->
    <ProjectReference Include="..\DbAdapter.StubPlugin\DbAdapter.StubPlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <Target Name="CopyStubPluginForCatalogTests" AfterTargets="Build">
    <PropertyGroup>
      <_StubPluginOutput>$(MSBuildThisFileDirectory)..\DbAdapter.StubPlugin\bin\$(Configuration)\$(TargetFramework)\</_StubPluginOutput>
    </PropertyGroup>
    <ItemGroup>
      <_StubPluginFile Include="$(_StubPluginOutput)DbAdapter.StubPlugin.dll" />
      <_StubPluginFile Include="$(_StubPluginOutput)DbAdapter.StubPlugin.deps.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_StubPluginFile)" DestinationFolder="$(OutDir)stubplugin\" SkipUnchangedFiles="true" />
  </Target>

</Project>