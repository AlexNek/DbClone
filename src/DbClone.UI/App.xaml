<Application
    x:Class="DbClone.UI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:DbClone.UI.Converters"
    xmlns:views="clr-namespace:DbClone.UI.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <converters:StringNotEmptyToBoolConverter x:Key="StringNotEmptyToBool" />
            <converters:HexColorToBrushConverter x:Key="HexColorToBrush" />
            <converters:InvertBoolConverter x:Key="InvertBoolConverter" />

            <!--  Implicit styles are keyed by exact runtime type, so the
                  SyncablePasswordBox subclass must re-key the WPF-UI PasswordBox
                  style to keep its template (eye icon, Fluent chrome).  -->
            <Style
                TargetType="{x:Type views:SyncablePasswordBox}"
                BasedOn="{StaticResource {x:Type ui:PasswordBox}}" />

            <!--  Command-bar button: compact height, padding, icon spacing  -->
            <Style
                x:Key="CommandBarButtonStyle"
                BasedOn="{StaticResource {x:Type ui:Button}}"
                TargetType="ui:Button">
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Appearance" Value="Transparent" />
            </Style>

            <!--  Primary action button in command bar  -->
            <Style
                x:Key="CommandBarPrimaryButtonStyle"
                BasedOn="{StaticResource CommandBarButtonStyle}"
                TargetType="ui:Button">
                <Setter Property="Appearance" Value="Primary" />
                <Setter Property="MinWidth" Value="70" />
            </Style>

            <!--  Small neutral button for compact form actions (New/Edit/Test)  -->
            <Style
                x:Key="CompactButtonStyle"
                BasedOn="{StaticResource {x:Type ui:Button}}"
                TargetType="ui:Button">
                <Setter Property="Appearance" Value="Transparent" />
                <Setter Property="Padding" Value="10,2" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="4" />
            </Style>

            <!--  Section header inside cards  -->
            <Style x:Key="SectionHeaderTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorPrimaryBrush}" />
            </Style>

            <!--  Right-aligned form labels  -->
            <Style x:Key="FormLabelTextBlockStyle" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,0,10,0" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <!--  Log list box: no border, theme background  -->
            <Style x:Key="LogListBoxStyle" TargetType="ListBox">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="LogListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="BorderBrush" Value="{ui:ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Style.Triggers>
                    <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                        <Setter Property="Background" Value="{ui:ThemeResource ControlFillColorSecondaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  Object item row in the schema panel  -->
            <Style x:Key="ObjectCountTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontFamily" Value="Consolas" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="TextAlignment" Value="Right" />
            </Style>

            <!--  Status badge pill  -->
            <Style x:Key="StatusBadgeBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="10,3" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Background" Value="{ui:ThemeResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ui:ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!--  Status colors for comparison results  -->
            <SolidColorBrush x:Key="StatusIdenticalBrush" Color="#4CAF50" />
            <SolidColorBrush x:Key="StatusNoticeBrush" Color="#2196F3" />
            <SolidColorBrush x:Key="StatusDifferentBrush" Color="#FFC107" />
            <SolidColorBrush x:Key="StatusMissingBrush" Color="#F44336" />
            <SolidColorBrush x:Key="StatusSkippedBrush" Color="#9E9E9E" />
            <SolidColorBrush x:Key="StatusUnknownBrush" Color="#9E9E9E" />
        </ResourceDictionary>
    </Application.Resources>
</Application>