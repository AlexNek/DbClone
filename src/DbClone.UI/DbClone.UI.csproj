<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>DbClone</AssemblyName>
    <Product>DbClone</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CanonicalModel\CanonicalModel.csproj" />
    <ProjectReference Include="..\DbClone.Application\DbClone.Application.csproj" />
    <!-- The engine project is referenced only for build ordering, so a plain build produces a
         populated plugins folder. ReferenceOutputAssembly=false keeps the engine assembly out of
         the application output and its types out of the UI's compile surface; the PublishAdapters
         target below publishes it into $(TargetDir)plugins\<dialect> where the catalog reads it
         (refactors/09 P10). This is the only file under src that names an adapter project. -->
    <ProjectReference Include="..\..\DbAdapter.PostgreSql\DbAdapter.PostgreSql.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autoupdater.NET.Official" Version="1.9.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Publish each engine project into the application output's plugins\<dialect> folder so the
       catalog can discover and load it at runtime. Runs after a plain Build (dev runs find the
       engine) and after Publish (the installer harvests the same folder). The engine is published
       from its own project, never copied from the UI's compile output. -->
  <Target Name="PublishAdapters" AfterTargets="Build;Publish">
    <PropertyGroup>
      <_PluginsOut>$(TargetDir)plugins\postgresql</_PluginsOut>
    </PropertyGroup>
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\..\DbAdapter.PostgreSql\DbAdapter.PostgreSql.csproj&quot; -c $(Configuration) -o &quot;$(_PluginsOut)&quot; --nologo -v q"
          Condition="'$(DesignTimeBuild)' != 'true'" />
  </Target>

</Project>
