{
  // Development overrides for a DEBUG run. The update feed is deliberately NOT
  // overridden here, so a DEBUG build checks the same GitHub release as a
  // Release build. To test against a local mock server instead, start it on
  // port 8080 and point the feed at it for that run only:
  //   PowerShell:  $env:Update__Url = "http://localhost:8080/mock-release.json"
  //   cmd:         set Update__Url=http://localhost:8080/mock-release.json
  // Environment variables are read after both appsettings files, so they win.
}
