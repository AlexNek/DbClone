<Window x:Class="DbClone.UI.Views.TableSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Select Tables"
        Width="920" Height="660"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Table grid for a single schema: Checkbox / Table / Size -->
        <GridView x:Key="TableGridSingleSchema">
            <GridViewColumn Width="46">
                <GridViewColumnHeader Content="✓" IsHitTestVisible="False"/>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Include table"/>
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="340">
                <GridViewColumnHeader Content="Table" Command="{Binding SortByCommand}" CommandParameter="Name"/>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding RelationshipIndicator}" VerticalAlignment="Center"
                                       FontSize="14"/>
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="110">
                <GridViewColumnHeader Content="Size" Command="{Binding SortByCommand}" CommandParameter="Size"/>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
        </GridView>

        <!-- Table grid for All Schemas: Checkbox / Schema / Table / Size -->
        <GridView x:Key="TableGridAllSchemas">
            <GridViewColumn Width="46">
                <GridViewColumnHeader Content="✓" IsHitTestVisible="False"/>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center"
                                      AutomationProperties.Name="Include table"/>
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="160">
                <GridViewColumnHeader Content="Schema" Command="{Binding SortByCommand}" CommandParameter="Schema"/>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Schema}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="320">
                <GridViewColumnHeader Content="Table" Command="{Binding SortByCommand}" CommandParameter="Name"/>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding RelationshipIndicator}" VerticalAlignment="Center"
                                       FontSize="14"/>
                        </StackPanel>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="110">
                <GridViewColumnHeader Content="Size" Command="{Binding SortByCommand}" CommandParameter="Size"/>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
        </GridView>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top: preset management -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Selection:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding PresetOptions}"
                      SelectedItem="{Binding SelectedPreset}"
                      DisplayMemberPath="Name"
                      Margin="0,0,8,0"
                      ToolTip="Available table selection presets for this database"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Content="Save" Click="SaveClick" Margin="0,0,4,0"
                           IsEnabled="{Binding IsNamedPresetLoaded}"
                           ToolTip="Overwrite the active preset with the current selection"/>
                <ui:Button Content="Save As..." Click="SaveAsClick" Margin="0,0,4,0"
                           ToolTip="Create a new preset from the current selection"/>
                <ui:Button Content="Rename" Click="RenameClick" Margin="0,0,4,0"
                           IsEnabled="{Binding IsNamedPresetLoaded}"/>
                <ui:Button Content="Delete" Click="DeleteClick"
                           IsEnabled="{Binding IsNamedPresetLoaded}"/>
            </StackPanel>
        </Grid>

        <!-- Middle: master-detail (or overlay states) -->
        <Grid Grid.Row="1">
            <!-- Loading state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
                <TextBlock Text="Reading tables from the source database..." Margin="0,10,0,0"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Error state (prominent — no stale or empty grid) -->
            <ui:InfoBar Title="Cannot load tables"
                        Message="{Binding LoadError}"
                        Severity="Error" IsOpen="True" IsClosable="False"
                        VerticalAlignment="Top" Margin="0,8,0,0">
                <ui:InfoBar.Style>
                    <Style TargetType="ui:InfoBar">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LoadError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:InfoBar.Style>
            </ui:InfoBar>

            <!-- Master-detail content -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    <Condition Binding="{Binding LoadError}" Value="{x:Null}"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: schemas -->
                <Border Grid.Column="0" BorderThickness="1"
                        BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                        CornerRadius="4" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="SCHEMAS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="10,8,10,4"/>
                        <ListView ItemsSource="{Binding SchemaNodes}"
                                  SelectedItem="{Binding SelectedSchemaNode}"
                                  VirtualizingPanel.IsVirtualizing="True">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked}"
                                                  VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding CountText}" Margin="8,0,0,0"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Border>

                <!-- Right: tables -->
                <Border Grid.Column="1" BorderThickness="1"
                        BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                        CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding TablesHeader}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="10,8,10,4"/>
                        <ui:TextBox DockPanel.Dock="Top"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Search tables..."
                                    Margin="8,0,8,6"/>
                        <ListView x:Name="TablesListView"
                                  ItemsSource="{Binding VisibleTables}"
                                  SelectedItem="{Binding SelectedTable}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.ScrollUnit="Pixel">
                            <!-- View is assigned in code-behind — switching the GridView
                                     through style triggers throws
                                     "View can't be shared by more than one ListView"
                                     when the trigger binding re-evaluates. -->
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="ToolTip" Value="{Binding RelationshipTooltip}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasDependencyWarning}" Value="True">
                                            <Setter Property="Background" Value="#33FFA500"/>
                                            <Setter Property="ToolTip" Value="⚠ Parent table is excluded — FK integrity will be broken"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Validation summary overlay (non-blocking, advisory) -->
            <Border Background="{ui:ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderThickness="1"
                    BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                    CornerRadius="6" Padding="16" Margin="40,20">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowValidationSummary}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Selection Validation"
                               FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock DockPanel.Dock="Top"
                               Text="The following will be skipped during the operation:"
                               Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,10"/>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <ui:Button Content="Go Back" Click="GoBackClick" Width="100" Height="32" Margin="0,0,8,0"/>
                        <ui:Button Content="Apply Anyway" Click="ApplyAnywayClick"
                                   Appearance="Primary" Width="130" Height="32"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ValidationSections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                        <ItemsControl ItemsSource="{Binding Lines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Margin="14,0,0,1"
                                                               TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Relationship details / status area (keyboard + screen-reader friendly) -->
        <TextBlock Grid.Row="2" Text="{Binding RelationshipDetails}"
                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="2,6,2,0"
                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                   ToolTip="{Binding RelationshipDetails}"/>

        <!-- Bottom: bulk actions + dialog actions -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ui:Button Content="Select All" Command="{Binding SelectAllCommand}" Margin="0,0,6,0"
                           ToolTip="Select every table in the database (not just the filtered view)"/>
                <ui:Button Content="Select None" Command="{Binding SelectNoneCommand}"
                           ToolTip="Deselect every table in the database (not just the filtered view)"/>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="{Binding SelectedCountText}"
                       VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="SemiBold"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <ui:Button Content="Cancel" Click="CancelClick" Width="90" Height="32" Margin="0,0,8,0"/>
                <ui:Button Content="Apply" Click="ApplyClick" Appearance="Primary" Width="90" Height="32"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
