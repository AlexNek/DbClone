<Window x:Class="DbClone.UI.Views.PresetNameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Save Table Selection"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Optional disclosure text (Save As…) -->
        <TextBlock Grid.Row="0" x:Name="DisclosureText"
                   FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock Text="Name" FontSize="12" Margin="0,0,0,4"/>
            <ui:TextBox x:Name="NameBox" MaxLength="100"
                        AutomationProperties.Name="Preset Name"/>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="ErrorText"
                   Foreground="Red" FontSize="12" TextWrapping="Wrap"
                   Visibility="Collapsed" Margin="0,0,0,4"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <ui:Button Content="Cancel" Width="80" Height="32" Margin="0,0,8,0"
                       Click="CancelClick"/>
            <ui:Button Content="Save" Width="80" Height="32"
                       Appearance="Primary"
                       Click="SaveClick"/>
        </StackPanel>
    </Grid>
</Window>
