<Window x:Class="DbClone.UI.Views.ColorPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:DbClone.UI.Views"
        Title="Select Color"
        Width="340"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height">
    <StackPanel Margin="16">
        <views:ColorPickerControl Margin="0,0,0,16"
                                   SelectedColor="{Binding SelectedColor, Mode=TwoWay}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="OK" Width="70" Margin="0,0,8,0"
                       Appearance="Primary" Click="OkClick"/>
            <ui:Button Content="Cancel" Width="70"
                       Click="CancelClick"/>
        </StackPanel>
    </StackPanel>
</Window>
