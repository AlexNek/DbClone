<ui:FluentWindow x:Class="DbClone.UI.Views.UnifiedConnectionManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:DbClone.UI.ViewModels"
        xmlns:views="clr-namespace:DbClone.UI.Views"
        xmlns:converters="clr-namespace:DbClone.UI.Converters"
        Title="Connection Manager"
        Width="1020" Height="750"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        KeyDown="Window_KeyDown">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:PlatformIdToDisplayNameConverter x:Key="PlatformIdToName"/>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid Background="{ui:ThemeResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Connection Manager"/>

        <!-- Shared toolbar: Export All / Import All — applies to BOTH connections and groups -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,8,8,0">
            <ui:Button Content="Export All"
                       Icon="{ui:SymbolIcon ArrowExportLtr24}"
                       Click="ExportAllToFile_Click"
                       AutomationProperties.Name="Export All Connections and Groups"
                       ToolTip="Export all connections and groups to a backup file"
                       Margin="0,0,6,0"/>
            <ui:Button Content="Import All"
                       Icon="{ui:SymbolIcon FolderOpen24}"
                       Click="ImportAllFromFile_Click"
                       AutomationProperties.Name="Import All Connections and Groups"
                       ToolTip="Import all connections and groups from a backup file"/>
        </StackPanel>

        <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    AutomationProperties.Name="Connection Manager Tabs">

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- Connections Tab                                                     -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <TabItem Header="Connections"
                 AutomationProperties.Name="Connections Tab">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left panel: Search + Connection list -->
                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                    <ui:TextBox DockPanel.Dock="Top"
                                Text="{Binding ConnectionSearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Search connections…"
                                ClearButtonEnabled="True"
                                AutomationProperties.Name="Search Connections"
                                Margin="0,0,0,6"/>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <ui:Button Content="New"
                                   Command="{Binding NewConnectionCommand}"
                                   AutomationProperties.Name="New Connection"
                                   Width="64" Margin="0,0,6,0"/>
                        <ui:Button Content="Duplicate"
                                   Command="{Binding DuplicateConnectionCommand}"
                                   AutomationProperties.Name="Duplicate Connection"
                                   Margin="0,0,6,0"/>
                        <ui:Button Content="Delete"
                                   Command="{Binding DeleteConnectionCommand}"
                                   AutomationProperties.Name="Delete Connection"
                                   Width="64"/>
                    </StackPanel>

                    <ListBox x:Name="ConnectionsList"
                             ItemsSource="{Binding FilteredConnections}"
                             SelectedItem="{Binding SelectedConnection}"
                             AutomationProperties.Name="Connections List"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ContextMenu>
                            <!-- Single shared menu: right-click, three-dot button, and toolbar More button all open this -->
                            <ContextMenu>
                                <MenuItem Header="Duplicate" Command="{Binding DuplicateConnectionCommand}"
                                          Icon="{ui:SymbolIcon Copy24}"/>
                                <Separator/>
                                <MenuItem Header="Export" Command="{Binding OpenExportDialogCommand}"
                                          Icon="{ui:SymbolIcon ArrowUpload24}"/>
                                <MenuItem Header="Export to File…" Click="ExportToFile_Click"
                                          Icon="{ui:SymbolIcon Save24}"/>
                                <MenuItem Header="Export to Clipboard" Command="{Binding ExportToClipboardCommand}"
                                          Icon="{ui:SymbolIcon ClipboardArrowRight24}"/>
                                <Separator/>
                                <MenuItem Header="Import from File…" Click="ImportFromFile_Click"
                                          Icon="{ui:SymbolIcon FolderOpen24}"/>
                                <MenuItem Header="Import from Clipboard" Command="{Binding ImportFromClipboardCommand}"
                                          Icon="{ui:SymbolIcon ClipboardPaste24}"/>
                                <Separator/>
                                <MenuItem Header="Test Connection" Command="{Binding TestConnectionCommand}"
                                          Icon="{ui:SymbolIcon PlugConnected24}"/>
                                <Separator/>
                                <MenuItem Header="Delete" Command="{Binding DeleteConnectionCommand}"
                                          Icon="{ui:SymbolIcon Delete24}" Foreground="Red"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,6"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Color dot + Name + Provider subtitle -->
                                    <StackPanel Grid.Column="0">
                                        <views:ColorIndicator Color="{Binding Color}" Label="{Binding Name}"
                                                              HighlightText="{Binding DataContext.ConnectionSearchText, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   Margin="16,1,0,0">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource PlatformIdToName}">
                                                    <Binding Path="ConnectionType"/>
                                                    <Binding Path="DataContext.ConnectionTypeValues" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Three-dot overflow button -->
                                    <TextBlock Grid.Column="1"
                                              Text="⋮"
                                              FontSize="16"
                                              VerticalAlignment="Top"
                                              HorizontalAlignment="Right"
                                              Margin="0,-2,0,0"
                                              Cursor="Hand"
                                              Foreground="White"
                                              AutomationProperties.Name="Connection Actions"
                                              Visibility="{Binding IsItemSelected, Converter={StaticResource BoolToVis}}"
                                              MouseLeftButtonUp="ConnectionItemMoreDots_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Right panel: Connection form -->
                <DockPanel Grid.Column="1">

                    <!-- ── Header bar ── -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Database24" Margin="0,0,6,0" FontSize="18"/>
                            <TextBlock Text="Connection Details" FontWeight="SemiBold" FontSize="14"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Import"
                                       Icon="{ui:SymbolIcon ArrowDownload24}"
                                       Command="{Binding OpenImportDialogCommand}"
                                       AutomationProperties.Name="Import Connection"
                                       Margin="0,0,6,0"/>
                            <ui:Button Content="Export"
                                       Icon="{ui:SymbolIcon ArrowUpload24}"
                                       Command="{Binding OpenExportDialogCommand}"
                                       AutomationProperties.Name="Export Connection"
                                       Margin="0,0,6,0"/>
                            <ui:Button Icon="{ui:SymbolIcon MoreVertical24}"
                                       AutomationProperties.Name="More Options"
                                       Click="MoreButton_Click" x:Name="MoreButton"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- ── Footer buttons ── -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <ui:Button Content="Test Connection"
                                   Icon="{ui:SymbolIcon Play24}"
                                   Command="{Binding TestConnectionCommand}"
                                   AutomationProperties.Name="Test Connection"
                                   Height="34" Margin="0,0,10,0"/>
                        <ui:Button Content="Save"
                                   Icon="{ui:SymbolIcon Save24}"
                                   Appearance="Primary"
                                   Command="{Binding SaveConnectionCommand}"
                                   AutomationProperties.Name="Save Connection"
                                   Height="34" Width="100" Margin="0,0,10,0"/>
                        <ui:Button Content="Close"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   AutomationProperties.Name="Close"
                                   Click="CloseButton_Click"
                                   Height="34"/>
                    </StackPanel>

                    <!-- ── Test result (above buttons) ── -->
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding TestResult}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontSize="11" HorizontalAlignment="Center"
                               Margin="0,4,0,0"/>

                    <!-- ── Tabs: General / Advanced ── -->
                    <TabControl Margin="0,4,0,0">
                        <TabItem Header="General" AutomationProperties.Name="General Tab">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                                <StackPanel>

                                    <!-- Name + Color -->
                                    <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Connection Name"/>
                                        <views:ColorPickerButton Grid.Column="1" Color="{Binding FormColor}"
                                                                 Command="{Binding PickConnectionColorCommand}"/>
                                    </Grid>

                                    <!-- Connection Type -->
                                    <TextBlock Text="Connection Type" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding ConnectionTypeValues}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding FormConnectionType}"
                                              AutomationProperties.Name="Connection Type"
                                              Margin="0,0,0,8"/>

                                    <!-- Host + Port -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Host" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding FormHost, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Host"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Port" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding FormPort, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Port"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="{Binding PortValidationError}"
                                               Foreground="Red" FontSize="11"
                                               Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PortValidationError}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Database + Browse -->
                                    <TextBlock Text="Database" Style="{StaticResource FieldLabel}"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding FormDatabaseName, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="Database Name"/>
                                        <ui:Button Grid.Column="1"
                                                   Content="Browse..."
                                                   Icon="{ui:SymbolIcon Folder24}"
                                                   Command="{Binding BrowseDatabasesCommand}"
                                                   AutomationProperties.Name="Browse Databases"
                                                   Margin="6,0,0,0"/>
                                    </Grid>

                                    <!-- Browse databases panel -->
                                    <Border Margin="0,0,0,8"
                                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="4" Padding="6"
                                            Visibility="{Binding IsBrowsingDatabases, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Text="Select database:" VerticalAlignment="Center"
                                                           FontSize="12" FontWeight="SemiBold"/>
                                                <ui:Button DockPanel.Dock="Right" Content="✕"
                                                           Command="{Binding CloseBrowseDatabasesCommand}"
                                                           AutomationProperties.Name="Close Browse"
                                                           Width="24" Height="24" HorizontalAlignment="Right"
                                                           Padding="0"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding BrowseDatabasesError}"
                                                       Foreground="Red" FontSize="11"
                                                       Margin="0,0,0,4"
                                                       TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding BrowseDatabasesError}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding BrowseDatabasesError}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ListBox ItemsSource="{Binding DiscoveredDatabases}"
                                                     SelectedItem="{Binding SelectedDiscoveredDatabase}"
                                                     AutomationProperties.Name="Discovered Databases"
                                                     MaxHeight="150"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Username + Password -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Username" Style="{StaticResource FieldLabel}"/>
                                            <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="Username"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Password" Style="{StaticResource FieldLabel}"/>
                                            <views:SyncablePasswordBox
                                                Password="{Binding FormPassword, Mode=TwoWay}"
                                                RevealButtonEnabled="True"
                                                AutomationProperties.Name="Password"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- SSL Mode -->
                                    <TextBlock Text="SSL Mode" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Source={x:Static Member=vm:UnifiedConnectionManagerViewModel.SslModeValues}}"
                                              SelectedItem="{Binding FormSslMode}"
                                              AutomationProperties.Name="SSL Mode"
                                              Margin="0,0,0,8"/>

                                    <!-- Backup Name -->
                                    <TextBlock Text="Backup Name" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding FormBackupName, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="Backup Name"
                                             ToolTip="Short label used as backup database prefix (e.g. crm, analytics). Leave empty to use database name."
                                             Margin="0,0,0,8"/>

                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem AutomationProperties.Name="Advanced Tab">
                            <TabItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" Margin="0,0,4,0" FontSize="14"/>
                                    <TextBlock Text="Advanced"/>
                                </StackPanel>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8,0,0">
                                <StackPanel>
                                    <!-- Notes -->
                                    <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             Height="100"
                                             AutomationProperties.Name="Connection Notes"
                                             Margin="0,0,0,8"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </TabItem>

        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <!-- Groups Tab                                                          -->
        <!-- ═══════════════════════════════════════════════════════════════════ -->
        <TabItem Header="Groups"
                 AutomationProperties.Name="Groups Tab">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left panel: Search + Group list -->
                <DockPanel Grid.Column="0" Margin="0,0,8,0">
                    <ui:TextBox DockPanel.Dock="Top"
                                Text="{Binding GroupSearchText, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="Search groups…"
                                ClearButtonEnabled="True"
                                AutomationProperties.Name="Search Groups"
                                Margin="0,0,0,6"/>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                        <ui:Button Content="New"
                                   Command="{Binding NewGroupCommand}"
                                   AutomationProperties.Name="New Group"
                                   Width="64" Margin="0,0,6,0"/>
                        <ui:Button Content="Delete"
                                   Command="{Binding DeleteGroupCommand}"
                                   AutomationProperties.Name="Delete Group"
                                   Width="64"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding FilteredGroups}"
                             SelectedItem="{Binding SelectedGroup}"
                             AutomationProperties.Name="Groups List">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <views:ColorIndicator Color="{Binding Color}" Label="{Binding Name}"
                                                      HighlightText="{Binding DataContext.GroupSearchText, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Right panel: Group form -->
                <DockPanel Grid.Column="1">

                    <!-- ── Footer buttons (docked bottom to align with list buttons) ── -->
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,12,0,0">
                        <ui:Button Content="Save"
                                   Icon="{ui:SymbolIcon Save24}"
                                   Appearance="Primary"
                                   Command="{Binding SaveGroupCommand}"
                                   AutomationProperties.Name="Save Group"
                                   Height="34" Width="100" Margin="0,0,10,0"/>
                        <ui:Button Content="Close"
                                   Icon="{ui:SymbolIcon Dismiss24}"
                                   AutomationProperties.Name="Close"
                                   Height="34"
                                   Click="CloseButton_Click"/>
                    </StackPanel>

                    <!-- ── Validation error (above buttons) ── -->
                    <TextBlock DockPanel.Dock="Bottom"
                               Text="{Binding GroupValidationError}"
                               Foreground="Red" FontSize="11"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GroupValidationError}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding GroupValidationError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0">
                        <TextBlock Text="Group Details" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>

                        <TextBlock Text="Group Name" Style="{StaticResource FieldLabel}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding GroupFormName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="Group Name"/>
                            <views:ColorPickerButton Grid.Column="1" Color="{Binding GroupFormColor}"
                                                     Command="{Binding PickGroupColorCommand}"/>
                        </Grid>

                        <TextBlock Text="Source Connection" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableConnections}"
                                  SelectedItem="{Binding GroupFormSourceConnection}"
                                  AutomationProperties.Name="Source Connection"
                                  Margin="0,0,0,4">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <views:ColorIndicator Color="{Binding Color}" Label="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock FontSize="11" Foreground="Gray" Margin="0,0,0,8">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}:{1}/{2}">
                                    <Binding Path="GroupFormSourceConnection.Host" FallbackValue="—"/>
                                    <Binding Path="GroupFormSourceConnection.Port" FallbackValue=""/>
                                    <Binding Path="GroupFormSourceConnection.DatabaseName" FallbackValue=""/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <TextBlock Text="Destination Connection" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding AvailableConnections}"
                                  SelectedItem="{Binding GroupFormDestinationConnection}"
                                  AutomationProperties.Name="Destination Connection"
                                  Margin="0,0,0,4">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <views:ColorIndicator Color="{Binding Color}" Label="{Binding Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock FontSize="11" Foreground="Gray" Margin="0,0,0,8">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}:{1}/{2}">
                                    <Binding Path="GroupFormDestinationConnection.Host" FallbackValue="—"/>
                                    <Binding Path="GroupFormDestinationConnection.Port" FallbackValue=""/>
                                    <Binding Path="GroupFormDestinationConnection.DatabaseName" FallbackValue=""/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <TextBlock Text="Notes" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding GroupFormNotes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="60"
                                 AutomationProperties.Name="Group Notes"
                                 Margin="0,0,0,6"/>

                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </TabItem>
    </TabControl>
    </Grid>
</ui:FluentWindow>
