<UserControl
    x:Class="DbClone.UI.Views.StatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <StatusBar
        Padding="10,4"
        Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0">
        <StatusBarItem>
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                DataContext="{Binding DataContext.ActiveState, RelativeSource={RelativeSource AncestorType=Window}}"
                Text="{Binding StatusBarSummary}" />
        </StatusBarItem>
        <Separator />
        <StatusBarItem>
            <TextBlock
                FontSize="12"
                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding Context.Source.Summary, StringFormat='Src: {0}'}" />
        </StatusBarItem>
        <Separator />
        <StatusBarItem>
            <TextBlock
                FontSize="12"
                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding Context.Destination.Summary, StringFormat='Dst: {0}'}" />
        </StatusBarItem>
        <Separator />
        <StatusBarItem>
            <TextBlock FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.SelectedMode}" Value="Compare">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="Mode: " />
                <Run Text="{Binding Settings.SelectedCopyMode, Mode=OneWay}" />
                <Run Text=" | Verify: " />
                <Run Text="{Binding Settings.SelectedVerifyMode, Mode=OneWay}" />
            </TextBlock>
        </StatusBarItem>
        <StatusBarItem>
            <TextBlock FontSize="12" Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.SelectedMode}" Value="Compare">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                <Run Text="Verify: " />
                <Run Text="{Binding Settings.SelectedVerifyMode, Mode=OneWay}" />
            </TextBlock>
        </StatusBarItem>
        <StatusBarItem HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal">
                <ui:Button
                    Padding="4,2"
                    Appearance="Transparent"
                    Command="{Binding ToggleThemeCommand}"
                    ToolTip="{Binding CurrentThemeMode, StringFormat='Theme: {0} (click to cycle)'}">
                    <ui:SymbolIcon FontSize="14" Symbol="{Binding ThemeIcon}" />
                </ui:Button>
                <TextBlock
                    FontSize="12"
                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                    Text="{Binding MemoryUsage}"
                    VerticalAlignment="Center"
                    Margin="8,0,0,0" />
            </StackPanel>
        </StatusBarItem>
    </StatusBar>
</UserControl>
