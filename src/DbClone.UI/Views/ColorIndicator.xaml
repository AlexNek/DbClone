<UserControl x:Class="DbClone.UI.Views.ColorIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <StackPanel Orientation="Horizontal">
        <Ellipse Width="{Binding Size, ElementName=Root}"
                 Height="{Binding Size, ElementName=Root}"
                 Fill="{Binding Color, ElementName=Root, Converter={StaticResource HexColorToBrush}}"
                 Stroke="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                 StrokeThickness="1"/>
        <TextBlock x:Name="LabelTextBlock"
                   Margin="6,0,0,0"
                   Visibility="{Binding HasLabel, ElementName=Root, Converter={StaticResource BoolToVis}}"/>
    </StackPanel>
</UserControl>
