<UserControl
    x:Class="DbClone.UI.Views.ProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <ui:Card
        Margin="0,12,0,0"
        Padding="14"
        Visibility="{Binding State.HasRun, Converter={StaticResource BoolToVis}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Style="{StaticResource SectionHeaderTextBlockStyle}"
                Text="Progress" />

            <!--  Overall progress  -->
            <ProgressBar
                Grid.Row="1"
                Height="18"
                Maximum="100"
                Minimum="0"
                Value="{Binding ProgressPercent}" />

            <Grid Grid.Row="2" Margin="0,6,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    FontWeight="SemiBold"
                    Text="{Binding CurrentPhase, Mode=OneWay}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock FontWeight="SemiBold" Text="{Binding ProgressPercent, StringFormat={}{0}%}" />
                    <TextBlock
                        Margin="12,0,0,0"
                        Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                        Text="  Elapsed: " />
                    <TextBlock FontWeight="SemiBold" Text="{Binding State.ElapsedTime}" />
                </StackPanel>
            </Grid>

            <!--  Table-level progress  -->
            <Border
                Grid.Row="3"
                Padding="12"
                BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                Visibility="{Binding IsCopyingData, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock
                            FontSize="11"
                            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                            Text="Current Table" />
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="{Binding CurrentTable}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="16,0">
                        <ProgressBar
                            Height="10"
                            Margin="0,4,0,2"
                            Maximum="100"
                            Minimum="0"
                            Value="{Binding TableProgressPercent}" />
                        <TextBlock>
                            <Run Text="Rows: " />
                            <Run Text="{Binding RowsProcessed, Mode=OneWay, StringFormat=N0}" />
                            <Run Text=" / " />
                            <Run Text="{Binding TotalRows, Mode=OneWay, StringFormat=N0}" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right"
                              Visibility="{Binding IsDataTransferStatsVisible, Converter={StaticResource BoolToVis}}">
                        <TextBlock>
                            <Run Text="Speed: " />
                            <Run Text="{Binding TransferSpeed, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock>
                            <Run Text="ETA: " />
                            <Run Text="{Binding EstimatedTimeRemaining, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock
                Grid.Row="3"
                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                Text="{Binding State.StatusMessage}" />
        </Grid>
    </ui:Card>
</UserControl>
