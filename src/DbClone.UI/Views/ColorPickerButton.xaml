<UserControl x:Class="DbClone.UI.Views.ColorPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:DbClone.UI.Views"
             x:Name="Root">
    <Button Command="{Binding Command, ElementName=Root}"
            Margin="8,0,0,0" VerticalAlignment="Center"
            Background="Transparent" BorderThickness="0" Padding="0"
            Cursor="Hand" ToolTip="Click to change color">
        <StackPanel Orientation="Horizontal">
            <views:ColorSwatch Color="{Binding Color, ElementName=Root}"
                               Size="{Binding Size, ElementName=Root}"/>
            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                       VerticalAlignment="Center" Margin="4,0,0,0"
                       Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>
    </Button>
</UserControl>
