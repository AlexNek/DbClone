<ui:FluentWindow x:Class="DbClone.UI.Views.ImportConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:converters="clr-namespace:DbClone.UI.Converters"
        xmlns:behaviors="clr-namespace:DbClone.UI.Behaviors"
        Title="Import Connection"
        Width="560" Height="520"
        Background="{ui:ThemeResource ApplicationBackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <ui:FluentWindow.Resources>
        <converters:WarningLevelToBrushConverter x:Key="WarningLevelToBrushConverter"/>
    </ui:FluentWindow.Resources>

    <Grid Margin="20" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Import Connection"/>

        <!-- Header -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Import Connection" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock Text="Paste a connection string — format is detected automatically"
                       FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Paste field -->
        <ui:TextBox Grid.Row="2"
                    Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                    PlaceholderText="postgresql://user:password@host:5432/database?sslmode=require"
                    AcceptsReturn="True" TextWrapping="Wrap"
                    MinHeight="72" MaxHeight="100"
                    VerticalScrollBarVisibility="Auto"
                    Margin="0,0,0,10"/>

        <!-- Detection badge + Detect button -->
        <DockPanel Grid.Row="3" Margin="0,0,0,12">
            <ui:Button DockPanel.Dock="Right" Content="Detect Format"
                       Command="{Binding DetectFormatCommand}"
                       Margin="8,0,0,0" Height="30"/>
            <TextBlock Text="{Binding DetectedFormatDisplay}"
                       VerticalAlignment="Center" FontSize="13" FontWeight="Medium">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#C62828"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DetectionState}" Value="success">
                                <Setter Property="Foreground" Value="#2E7D32"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DetectionState}" Value="warning">
                                <Setter Property="Foreground" Value="#F57C00"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <!-- Import as -->
        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="Import as" FontSize="12" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding ImportAsOptions}"
                      SelectedItem="{Binding SelectedImportAs}"
                      HorizontalAlignment="Stretch" Height="32" FontSize="13"/>
        </StackPanel>

        <!-- Preview section -->
        <Border Grid.Row="5" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Parsed Values" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Host" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Preview.Connection.Host, FallbackValue=—}" FontSize="12"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Port" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding Preview.Connection.Port}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Preview.Connection.Port}" Value="-1">
                                            <Setter Property="Text" Value="—"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Database" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Preview.Connection.Database, FallbackValue=—}" FontSize="12"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Username" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Preview.Connection.Username, FallbackValue=—}" FontSize="12"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Password" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" FontSize="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="••••••••"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Preview.Connection.Password}" Value="">
                                            <Setter Property="Text" Value="—"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Preview.Connection.Password}" Value="{x:Null}">
                                            <Setter Property="Text" Value="—"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="SSL Mode" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Preview.Connection.SslMode, FallbackValue=—}" FontSize="12"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Format" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Preview.DetectedFormatName, FallbackValue=—}" FontSize="12"/>
                    </Grid>

                    <!-- Additional parsed options -->
                    <ItemsControl ItemsSource="{Binding Preview.Connection.Options}" Margin="0,4,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Warnings -->
                    <ItemsControl ItemsSource="{Binding Preview.Warnings}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Margin="0,1"
                                           behaviors:HyperlinkTextBehavior.Text="{Binding Message}"
                                           behaviors:HyperlinkTextBehavior.Foreground="{Binding Level, Converter={StaticResource WarningLevelToBrushConverter}}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Footer buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
            <ui:Button Content="Cancel" Width="80" Height="32" Margin="0,0,8,0"
                       Click="CancelClick"/>
            <ui:Button Content="Import" Width="80" Height="32"
                       Appearance="Primary"
                       IsEnabled="{Binding CanImport}"
                       Click="ImportClick"/>
        </StackPanel>

        <!-- Supported formats reference -->
        <TextBlock Grid.Row="7" FontSize="10"
                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                   TextWrapping="Wrap"
                   Text="Supported: Npgsql/.NET • PostgreSQL URI • libpq/psql • JDBC • SQLAlchemy • Prisma • Node.js • Supabase • Environment Variables"/>
    </Grid>
</ui:FluentWindow>
