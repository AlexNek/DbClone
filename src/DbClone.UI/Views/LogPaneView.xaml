<UserControl
    x:Class="DbClone.UI.Views.LogPaneView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:enums="clr-namespace:DbClone.Application.Enums;assembly=DbClone.Application"
    xmlns:models="clr-namespace:DbClone.UI.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <DockPanel>

        <!--  ═══ Toolbar (top of log pane) ═══  -->
        <Border
            Padding="4,2"
            Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
            BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0"
            DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Pane label  -->
                <TextBlock
                    Grid.Column="0"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold">
                    <Run Text="Runtime Log" />
                    <Run Text=" (" />
                    <Run Text="{Binding LogMessages.Count, Mode=OneWay}" />
                    <Run Text=" entries)" />
                </TextBlock>

                <!--  Action buttons  -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ToggleButton
                        Margin="0,0,6,0"
                        Padding="6,2"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsErrorsOnly}"
                        ToolTip="Show errors only">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon
                                Margin="0,0,4,0"
                                FontSize="13"
                                Symbol="Filter16" />
                            <TextBlock FontSize="11" Text="Errors only" />
                        </StackPanel>
                    </ToggleButton>
                    <ui:Button
                        Margin="0,0,2,0"
                        Padding="6,2"
                        Appearance="Transparent"
                        Command="{Binding CopyLogRowCommand}"
                        ToolTip="Copy selected row">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Copy16" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Margin="0,0,2,0"
                        Padding="6,2"
                        Appearance="Transparent"
                        Command="{Binding CopyAllLogCommand}"
                        ToolTip="Copy all log entries">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Clipboard24" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <ui:Button
                        Margin="0,0,2,0"
                        Padding="6,2"
                        Appearance="Transparent"
                        Command="{Binding ClearLogCommand}"
                        ToolTip="Clear Log (Ctrl+L)">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Delete24" />
                        </ui:Button.Icon>
                    </ui:Button>

                </StackPanel>
            </Grid>
        </Border>

        <!--  ═══ Log list (fills remaining space) ═══  -->
        <ListBox
            x:Name="LogListBox"
            AlternationCount="2"
            ItemContainerStyle="{StaticResource LogListBoxItemStyle}"
            ItemsSource="{Binding FilteredLogMessages}"
            SelectedItem="{Binding SelectedLogEntry}"
            Style="{StaticResource LogListBoxStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:LogEntry}">
                    <!--  Severity coloring driven by LogEntry.Level  -->
                    <TextBlock Text="{Binding Display}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static enums:ELogLevel.Hint}">
                                        <Setter Property="Foreground" Value="{ui:ThemeResource TextFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static enums:ELogLevel.Warning}">
                                        <Setter Property="Foreground" Value="{ui:ThemeResource SystemFillColorCautionBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static enums:ELogLevel.Error}">
                                        <Setter Property="Foreground" Value="{ui:ThemeResource SystemFillColorCriticalBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Command="{Binding CopyLogRowCommand}" Header="Copy Row" />
                    <MenuItem Command="{Binding CopyAllLogCommand}" Header="Copy All" />
                    <Separator />
                    <MenuItem Command="{Binding ClearLogCommand}" Header="Clear Log" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </DockPanel>
</UserControl>
