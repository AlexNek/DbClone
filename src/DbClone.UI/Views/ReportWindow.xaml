<ui:FluentWindow x:Class="DbClone.UI.Views.ReportWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:converters="clr-namespace:DbClone.UI.Converters"
                 Title="Comparison Report"
                 Width="900" Height="700"
                 WindowStartupLocation="CenterOwner"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <converters:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroVis" />
    </ui:FluentWindow.Resources>
    <Grid Background="{ui:ThemeResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <ui:TitleBar Grid.Row="0" Title="Comparison Report"/>

        <!-- Toolbar with export buttons -->
        <Border Grid.Row="1" VerticalAlignment="Top"
                Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Export:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>
                <ui:Button Content="HTML" Style="{StaticResource CommandBarButtonStyle}" Command="{Binding ExportToHtmlCommand}" Margin="0,0,4,0"/>
                <ui:Button Content="Markdown" Style="{StaticResource CommandBarButtonStyle}" Command="{Binding ExportToMarkdownCommand}" Margin="0,0,4,0"/>
                <ui:Button Content="JSON" Style="{StaticResource CommandBarButtonStyle}" Command="{Binding ExportToJsonCommand}" Margin="0,0,4,0"/>
                <Border Width="1" Margin="8,2" Background="{ui:ThemeResource ControlStrokeColorDefaultBrush}"/>
                <ui:Button Content="Copy to Clipboard" Style="{StaticResource CommandBarButtonStyle}" Command="{Binding CopyToClipboardCommand}"/>
            </StackPanel>
        </Border>

        <!-- Report content -->
        <ScrollViewer Grid.Row="1" Margin="0,50,0,0" Padding="24" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Header -->
                <TextBlock Text="Database Comparison Report" FontSize="24" FontWeight="Bold" Margin="0,0,0,8"/>
                <TextBlock Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}">
                    <Run Text="Generated: "/>
                    <Run Text="{Binding ReportGeneratedAt, Mode=OneWay}"/>
                </TextBlock>
                <TextBlock Text="{Binding Source.Summary, StringFormat='Source: {0}'}" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Destination.Summary, StringFormat='Destination: {0}'}"/>

                <!-- Summary -->
                <TextBlock Text="Summary" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,12"/>
                <WrapPanel>
                    <Border Style="{StaticResource StatusBadgeBorderStyle}" Margin="0,0,8,8">
                        <TextBlock>
                            <Run Text="🟢" Foreground="{StaticResource StatusIdenticalBrush}"/>
                            <Run Text=" Identical: "/>
                            <Run Text="{Binding TotalIdentical}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatusBadgeBorderStyle}" Margin="0,0,8,8"
                            ToolTip="Objects that match but carry a non-structural note (e.g. schema owner differs)"
                            Visibility="{Binding TotalNotices, Converter={StaticResource GreaterThanZeroVis}}">
                        <TextBlock>
                            <Run Text="🔵" Foreground="{StaticResource StatusNoticeBrush}"/>
                            <Run Text=" Notices: "/>
                            <Run Text="{Binding TotalNotices}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatusBadgeBorderStyle}" Margin="0,0,8,8">
                        <TextBlock>
                            <Run Text="🟡" Foreground="{StaticResource StatusDifferentBrush}"/>
                            <Run Text=" Different: "/>
                            <Run Text="{Binding TotalDifferent}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatusBadgeBorderStyle}" Margin="0,0,8,8">
                        <TextBlock>
                            <Run Text="🔴" Foreground="{StaticResource StatusMissingBrush}"/>
                            <Run Text=" Missing Src: "/>
                            <Run Text="{Binding TotalMissingSource}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatusBadgeBorderStyle}" Margin="0,0,8,8">
                        <TextBlock>
                            <Run Text="🔴" Foreground="{StaticResource StatusMissingBrush}"/>
                            <Run Text=" Missing Dst: "/>
                            <Run Text="{Binding TotalMissingDest}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatusBadgeBorderStyle}" Margin="0,0,8,8">
                        <TextBlock>
                            <Run Text="⚪" Foreground="{StaticResource StatusSkippedBrush}"/>
                            <Run Text=" Skipped: "/>
                            <Run Text="{Binding TotalSkipped}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatusBadgeBorderStyle}" Margin="0,0,8,8">
                        <TextBlock>
                            <Run Text="⚠" Foreground="{StaticResource StatusMissingBrush}"/>
                            <Run Text=" Errors: "/>
                            <Run Text="{Binding TotalErrors}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Border>
                    <Border Style="{StaticResource StatusBadgeBorderStyle}" Margin="0,0,8,8">
                        <TextBlock>
                            <Run Text="Duration: " Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                            <Run Text="{Binding CompareDuration}" FontWeight="SemiBold"/>
                        </TextBlock>
                    </Border>
                </WrapPanel>

                <!-- Results table -->
                <TextBlock Text="Results" FontSize="18" FontWeight="SemiBold" Margin="0,24,0,12"/>
                <DataGrid ItemsSource="{Binding CompareResultItems}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserSortColumns="True"
                          HeadersVisibility="Column"
                          RowHeaderWidth="0"
                          MaxHeight="400">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding ObjectTypeDisplay}" Width="1.2*"/>
                        <DataGridTextColumn Header="Object Name" Binding="{Binding TableName}" Width="3*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="1.5*"/>
                        <DataGridTextColumn Header="Source Rows" Binding="{Binding SourceCountDisplay}" Width="1*"/>
                        <DataGridTextColumn Header="Dest Rows" Binding="{Binding DestCountDisplay}" Width="1*"/>
                        <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="3*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                    <Setter Property="ToolTip" Value="{Binding Details}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
