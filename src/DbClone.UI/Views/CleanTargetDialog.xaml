<Window x:Class="DbClone.UI.Views.CleanTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{Binding Title}"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Warning icon + message -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="⚠" FontSize="28" Foreground="#E6A817"
                       VerticalAlignment="Top" Margin="0,0,12,0"/>

            <TextBlock Grid.Column="1" Text="{Binding Message}"
                       FontSize="13" TextWrapping="Wrap" VerticalAlignment="Top"/>
        </Grid>

        <!-- Action buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="Clear All" Width="120" Height="32" Margin="0,0,8,0"
                       ToolTip="Clear the entire destination. After the copy it will contain ONLY the selected tables."
                       Click="ClearAllClick"/>
            <ui:Button Content="Replace Selected" Width="140" Height="32" Margin="0,0,8,0"
                       Appearance="Primary"
                       ToolTip="Replace only the selected tables. All other tables remain untouched."
                       Click="ReplaceSelectedClick"/>
            <ui:Button Content="Cancel" Width="80" Height="32"
                       Click="CancelClick"/>
        </StackPanel>
    </Grid>
</Window>
