<Window
    x:Class="DbClone.UI.Views.AboutDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="About DbClone"
    Width="420"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  App identity  -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
            <Image
                Width="64"
                Height="64"
                Source="/Assets/app.ico" />
            <TextBlock
                x:Name="AppNameText"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                FontSize="20"
                FontWeight="SemiBold" />
            <TextBlock
                x:Name="VersionText"
                Margin="0,4,0,0"
                HorizontalAlignment="Center"
                FontSize="13"
                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!--  Description  -->
        <TextBlock
            Grid.Row="1"
            Margin="0,20,0,0"
            HorizontalAlignment="Center"
            FontSize="12"
            Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
            Text="Copy PostgreSQL database schemas and data between servers&#x0a;with dependency-aware ordering, verification, and reporting."
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <!--  Links  -->
        <StackPanel Grid.Row="2" Margin="0,16,0,0" HorizontalAlignment="Center">
            <TextBlock HorizontalAlignment="Center" FontSize="12">
                <Hyperlink x:Name="RepoLink" Click="RepoLink_Click">
                    <Run x:Name="RepoLinkText" />
                </Hyperlink>
            </TextBlock>
            <TextBlock
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                FontSize="11"
                Foreground="{ui:ThemeResource TextFillColorTertiaryBrush}"
                Text="Open-source under the MIT License" />
        </StackPanel>

        <!--  Update status  -->
        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock
                x:Name="UpdateStatusText"
                HorizontalAlignment="Center"
                FontSize="12"
                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                Text="Checking for updates…"
                Visibility="Collapsed" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <!--  Check for Updates  -->
                <ui:Button
                    x:Name="CheckForUpdatesButton"
                    Height="32"
                    Margin="0,8,0,0"
                    Appearance="Info"
                    Click="CheckForUpdatesClick"
                    Content="Check for Updates">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowSync16" />
                    </ui:Button.Icon>
                </ui:Button>
                <!--  Update Now (shown when an update is available)  -->
                <ui:Button
                    x:Name="UpdateNowButton"
                    Height="32"
                    Margin="0,8,0,0"
                    Appearance="Success"
                    Click="UpdateNowClick"
                    Content="Update Now"
                    Visibility="Collapsed">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowDownload24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </StackPanel>

        <!--  Close  -->
        <ui:Button
            Grid.Row="4"
            Width="90"
            Height="32"
            Margin="0,12,0,0"
            HorizontalAlignment="Center"
            Appearance="Primary"
            Click="CloseClick"
            Content="OK"
            IsDefault="True" />
    </Grid>
</Window>
