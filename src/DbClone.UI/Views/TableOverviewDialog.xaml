<Window x:Class="DbClone.UI.Views.TableOverviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Table Overview"
        Width="820" Height="580"
        MinWidth="660" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Table grid for a single schema: Table / Size -->
        <GridView x:Key="OverviewGridSingleSchema">
            <GridViewColumn Width="420">
                <GridViewColumnHeader Content="Table" Command="{Binding SortByCommand}" CommandParameter="Name"/>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="110">
                <GridViewColumnHeader Content="Size" Command="{Binding SortByCommand}" CommandParameter="Size"/>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
        </GridView>

        <!-- Table grid for All Schemas: Schema / Table / Size -->
        <GridView x:Key="OverviewGridAllSchemas">
            <GridViewColumn Width="160">
                <GridViewColumnHeader Content="Schema" Command="{Binding SortByCommand}" CommandParameter="Schema"/>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Schema}" TextTrimming="CharacterEllipsis"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="360">
                <GridViewColumnHeader Content="Table" Command="{Binding SortByCommand}" CommandParameter="Name"/>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
            <GridViewColumn Width="110">
                <GridViewColumnHeader Content="Size" Command="{Binding SortByCommand}" CommandParameter="Size"/>
                <GridViewColumn.CellTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                    </DataTemplate>
                </GridViewColumn.CellTemplate>
            </GridViewColumn>
        </GridView>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top: database selector -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Database:" VerticalAlignment="Center" Margin="0,0,8,0"
                       FontWeight="SemiBold"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding AvailableDatabases}"
                      SelectedItem="{Binding SelectedDatabase}"
                      ToolTip="Select a database to view its tables"
                      Margin="0,0,8,0"/>
            <ui:ProgressRing Grid.Column="2" Width="20" Height="20"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBrowsingDatabases, Converter={StaticResource BoolToVis}}"/>
        </Grid>

        <!-- Middle: main content (or overlay states) -->
        <Grid Grid.Row="1">
            <!-- No database selected state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDatabaseSelected}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Select a database from the dropdown above to view its tables."
                           FontSize="13"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Loading state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="True"/>
                                    <Condition Binding="{Binding HasDatabaseSelected}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42"/>
                <TextBlock Text="Reading tables from the database..." Margin="0,10,0,0"
                           Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Error state -->
            <ui:InfoBar Title="Cannot load tables"
                        Message="{Binding LoadError}"
                        Severity="Error" IsOpen="True" IsClosable="False"
                        VerticalAlignment="Top" Margin="0,8,0,0">
                <ui:InfoBar.Style>
                    <Style TargetType="ui:InfoBar">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LoadError}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:InfoBar.Style>
            </ui:InfoBar>

            <!-- Master-detail content -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsLoading}" Value="False"/>
                                    <Condition Binding="{Binding LoadError}" Value="{x:Null}"/>
                                    <Condition Binding="{Binding HasDatabaseSelected}" Value="True"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: schemas -->
                <Border Grid.Column="0" BorderThickness="1"
                        BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                        CornerRadius="4" Margin="0,0,8,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="SCHEMAS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="10,8,10,4"/>
                        <ListView ItemsSource="{Binding SchemaNodes}"
                                  SelectedItem="{Binding SelectedSchemaNode}"
                                  VirtualizingPanel.IsVirtualizing="True">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalCount}" Margin="8,0,0,0"
                                                   FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>
                </Border>

                <!-- Right: tables -->
                <Border Grid.Column="1" BorderThickness="1"
                        BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                        CornerRadius="4">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding TablesHeader}"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="10,8,10,4"/>
                        <ui:TextBox DockPanel.Dock="Top"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                    PlaceholderText="Search tables..."
                                    Margin="8,0,8,6"/>
                        <ListView x:Name="TablesListView"
                                  ItemsSource="{Binding VisibleTables}"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.ScrollUnit="Pixel"/>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom: count + close button -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding TotalCountText}"
                       VerticalAlignment="Center" FontWeight="SemiBold"/>

            <ui:Button Grid.Column="1" Content="Close" Click="CloseClick"
                       Width="90" Height="32"/>
        </Grid>
    </Grid>
</Window>
